# URL publique du site (redirections CinetPay). En local : http://localhost:3000
# — mais le webhook de notification ne peut pas atteindre localhost, voir notes.
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API (à créer sur supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle secrete (bypass RLS) — reservee au webhook de paiement, jamais exposee
# au navigateur. Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — utilisé par Supabase Auth (Authentication > Providers > Phone)
# pour l'envoi des codes OTP par SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# CinetPay — paiement mobile money (Orange Money, MTN, Wave, Moov) + carte
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# AWS Rekognition — filtre automatique (visage net et unique) avant la file
# de vérification manuelle. Créer un utilisateur IAM avec uniquement la
# permission "AmazonRekognitionReadOnlyAccess" (ou "rekognition:DetectFaces").
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
